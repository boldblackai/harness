ARG BASE_IMAGE=ghcr.io/boldblackai/harness:latest
ARG UV_DIGEST=sha256:5cc1805e2426484abca4ad46ea783bab281fdb225fd82d8ce6d66a81254bac85

FROM ghcr.io/astral-sh/uv@${UV_DIGEST} AS uv-src

FROM ${BASE_IMAGE}

USER root

ARG UV_VERSION=0.13.8
ARG UV_DIGEST=sha256:5cc1805e2426484abca4ad46ea783bab281fdb225fd82d8ce6d66a81254bac85
ARG COSIGN_VERSION=3.1.4
ARG COSIGN_AMD64_SHA256=424e2c97d0b45fd7a6b608a87f090f35633f4c23ece5f092d48bba11aaf4bbfa
ARG COSIGN_ARM64_SHA256=ade83b7aac62e131cacfe96d958948b2150cc9efec46a570a2649b8e27dedad2
ARG TARGETARCH

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Bounded-retry fetch wrapper for every verify-chain download below; removed
# by the last verify RUN so the shipped filesystem carries no extra file.
COPY scripts/fetch-retry.sh /tmp/fetch-retry.sh

RUN set -eux && \
    ARCH="${TARGETARCH:-$(dpkg --print-architecture)}" && \
    bash /tmp/fetch-retry.sh /usr/local/bin/cosign \
        "https://github.com/sigstore/cosign/releases/download/v${COSIGN_VERSION}/cosign-linux-${ARCH}" && \
    case "${ARCH}" in \
        amd64) EXPECTED="${COSIGN_AMD64_SHA256}" ;; \
        arm64) EXPECTED="${COSIGN_ARM64_SHA256}" ;; \
        *) echo "unsupported arch: ${ARCH}"; exit 1 ;; \
    esac && \
    echo "${EXPECTED}  /usr/local/bin/cosign" | sha256sum --check --strict && \
    chmod +x /usr/local/bin/cosign && \
    bash /tmp/fetch-retry.sh /tmp/cosign_checksums.txt \
        "https://github.com/sigstore/cosign/releases/download/v${COSIGN_VERSION}/cosign_checksums.txt" && \
    bash /tmp/fetch-retry.sh /tmp/cosign_checksums.txt.sigstore.json \
        "https://github.com/sigstore/cosign/releases/download/v${COSIGN_VERSION}/cosign_checksums.txt.sigstore.json" && \
    cosign verify-blob \
        --new-bundle-format \
        --bundle /tmp/cosign_checksums.txt.sigstore.json \
        --certificate-identity "keyless@projectsigstore.iam.gserviceaccount.com" \
        --certificate-oidc-issuer "https://accounts.google.com" \
        /tmp/cosign_checksums.txt && \
    rm -f /tmp/cosign_checksums.txt /tmp/cosign_checksums.txt.sigstore.json && \
    apt-get update -qq && \
    apt-get install -y --no-install-recommends python3 python3-venv python3-snappy sqlite3 && \
    rm -rf /var/lib/apt/lists/*

COPY --from=uv-src /uv /usr/local/bin/uv

# Managed CPython for the hermes venv. python-build-standalone bundles its own
# SQLite (3.14.8 ships 3.53.1), which decouples hermes from the system
# libsqlite3 (Debian trixie: 3.46.1 — exposed to the WAL-reset corruption bug
# fixed upstream in 3.51.3, 2026-03-13, backported only to 3.50.7/3.44.6).
# Install dir must be world-readable so the venv's python symlink resolves
# for the runtime `harness` user.
ENV UV_PYTHON_INSTALL_DIR=/usr/local/share/uv/python

RUN set -eux && \
    bash /tmp/fetch-retry.sh /tmp/uv-attestations.json \
        "https://api.github.com/repos/astral-sh/uv/attestations/${UV_DIGEST}" \
        -H "Accept: application/vnd.github+json" && \
    BUNDLE_URL=$(jq -r '.attestations[0].bundle_url // .attestations[0].bundle' /tmp/uv-attestations.json) && \
    if echo "${BUNDLE_URL}" | grep -q '^https\?://'; then \
        bash /tmp/fetch-retry.sh /tmp/uv-bundle.json.sn "${BUNDLE_URL}" && \
        python3 -c "import snappy,sys; sys.stdout.buffer.write(snappy.decompress(open('/tmp/uv-bundle.json.sn','rb').read()))" > /tmp/uv-bundle.json; \
    else \
        jq '.attestations[0].bundle' /tmp/uv-attestations.json > /tmp/uv-bundle.json; \
    fi && \
    cosign verify-blob-attestation \
        --new-bundle-format \
        --bundle /tmp/uv-bundle.json \
        --type slsaprovenance1 \
        --certificate-identity-regexp "https://github.com/astral-sh/uv/.*" \
        --certificate-oidc-issuer "https://token.actions.githubusercontent.com" \
        --check-claims=false \
        /usr/local/bin/uv && \
    rm -f /tmp/uv-attestations.json /tmp/uv-bundle.json /tmp/uv-bundle.json.sn

RUN set -eux && \
    ARCH="${TARGETARCH:-$(dpkg --print-architecture)}" && \
    TIRITH_VERSION=0.2.12 && \
    case "${ARCH}" in \
        amd64) TIRITH_ARCH=x86_64-unknown-linux-gnu ;; \
        arm64) TIRITH_ARCH=aarch64-unknown-linux-gnu ;; \
    esac && \
    TIRITH_FILE="tirith-${TIRITH_ARCH}.tar.gz" && \
    bash /tmp/fetch-retry.sh /tmp/checksums.txt \
        "https://github.com/sheeki03/tirith/releases/download/v${TIRITH_VERSION}/checksums.txt" && \
    bash /tmp/fetch-retry.sh /tmp/checksums.txt.pem \
        "https://github.com/sheeki03/tirith/releases/download/v${TIRITH_VERSION}/checksums.txt.pem" && \
    bash /tmp/fetch-retry.sh /tmp/checksums.txt.sig \
        "https://github.com/sheeki03/tirith/releases/download/v${TIRITH_VERSION}/checksums.txt.sig" && \
    cosign verify-blob \
        --cert /tmp/checksums.txt.pem \
        --signature /tmp/checksums.txt.sig \
        --certificate-identity-regexp "https://github.com/sheeki03/tirith/.github/workflows/.*" \
        --certificate-oidc-issuer "https://token.actions.githubusercontent.com" \
        /tmp/checksums.txt && \
    bash /tmp/fetch-retry.sh "/tmp/${TIRITH_FILE}" \
        "https://github.com/sheeki03/tirith/releases/download/v${TIRITH_VERSION}/${TIRITH_FILE}" && \
    grep "${TIRITH_FILE}" /tmp/checksums.txt | sed "s|${TIRITH_FILE}|/tmp/${TIRITH_FILE}|" | sha256sum --check --strict && \
    tar -xzf "/tmp/${TIRITH_FILE}" -C /usr/local/bin/ tirith && \
    rm -f /tmp/checksums.txt /tmp/checksums.txt.pem /tmp/checksums.txt.sig "/tmp/${TIRITH_FILE}" /tmp/fetch-retry.sh

# Mirrors upstream's [tool.uv] override-dependencies for the one conflict our
# install resolution hits; see hermes-uv-overrides.txt for provenance and the
# removal condition.
COPY hermes-uv-overrides.txt /tmp/hermes-uv-overrides.txt

# hadolint ignore=DL3008
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3-dev build-essential git libffi-dev libolm-dev \
    && uv python install --no-cache 3.14.8 \
    && git clone --depth 1 --branch v0.23.1 https://github.com/NousResearch/hermes-agent.git /opt/hermes-agent \
    && uv venv /opt/hermes-agent/venv --python 3.14.8 \
    # telegram + stt-whisper are upstream's own extras: python-telegram-bot
    # 22.8 (with [webhooks], matching upstream's pin) and faster-whisper 1.2.1
    # now ride the project's pins instead of hand-maintained side pins. The
    # kokoro-onnx side pin is dropped entirely: upstream removed it in v0.23
    # (local TTS moved to KittenTTS/Piper) and local TTS has been removed due
    # to lack of demand. Lazy installs are disabled, so local TTS exists only
    # when baked here:
    # add kittentts/piper to the extras line if a deployment needs it (models
    # and voices still download at first use).
    && VIRTUAL_ENV=/opt/hermes-agent/venv uv pip install --no-cache-dir --overrides /tmp/hermes-uv-overrides.txt --exclude-newer="$(date -u -d '7 days ago' '+%Y-%m-%dT%H:%M:%SZ')" -e /opt/hermes-agent[mcp,web,pty,matrix,bedrock,slack,anthropic,telegram,stt-whisper] \
    && VIRTUAL_ENV=/opt/hermes-agent/venv uv pip install --no-cache-dir --exclude-newer-package 'certifi=2999-01-01T00:00:00Z' "certifi==2026.10.19" \
    && ln -sf /opt/hermes-agent/venv/bin/hermes /usr/local/bin/hermes \
    && cd /opt/hermes-agent \
    # Build the web UI with PM's pinned toolchain, not the base image's (#204).
    # Since v0.23 the repo is a pnpm workspace: plain `npm install` in web/ dies
    # on the workspace:* protocol, and scripts/build/node-deps.mjs refuses any
    # pnpm but the pin recorded in pm/lock.json — so both node and pnpm come
    # from PM. node-deps.mjs installs the web workspace's locked closure
    # (filter `./web...` includes @hermes/shared); web.mjs with no args builds
    # in-tree into hermes_cli/web_dist (the build receipt it records is read
    # back via PM's node — same class of stale-receipt guard as #204).
    && python3 -c 'from pm import ensure; ensure("node", explicit=True); ensure("pnpm", explicit=True)' \
    # Resolve the PM-provisioned bins and fail loud if either is missing — a
    # silent miss would degrade PATH to the base image's node/pnpm and recreate
    # the stale-receipt crash loop this fixes (#204). The pnpm bin dir goes
    # first: PM's pinned pnpm (12.15.0 per pm/lock.json) must shadow the base
    # image's corepack pnpm, which node-deps.mjs refuses.
    && PM_NODE_BIN="$(python3 -c 'import shutil; from pm import env_for; print(shutil.which("node", path=env_for("pnpm")["PATH"]))')" \
    && PM_PNPM_BIN="$(python3 -c 'import shutil; from pm import env_for; print(shutil.which("pnpm", path=env_for("pnpm")["PATH"]))')" \
    && test -n "$PM_NODE_BIN" && test -n "$PM_PNPM_BIN" \
    && PATH="$(dirname "$PM_PNPM_BIN"):$(dirname "$PM_NODE_BIN"):$PATH" node scripts/build/node-deps.mjs --source /opt/hermes-agent --workspace web \
    && PATH="$(dirname "$PM_PNPM_BIN"):$(dirname "$PM_NODE_BIN"):$PATH" node scripts/build/web.mjs \
    && test -f /opt/hermes-agent/hermes_cli/web_dist/index.html \
    # Webapp (browser-hosted Desktop) bundle: upstream's own webapp_build
    # recipe (its Dockerfile's webapp_build stage), run in this checkout with
    # the same PM-pinned toolchain. build-webapp.mjs --deps-only installs the
    # private build workspace (the apps/desktop closure, no Electron binary)
    # keyed on the manifests; the build writes apps/desktop/dist-webapp with a
    # freshness receipt, so a later `hermes webapp` proves the bundle current
    # and never rebuilds. Verified below, like web_dist is.
    && PATH="$(dirname "$PM_PNPM_BIN"):$(dirname "$PM_NODE_BIN"):$PATH" node apps/desktop/scripts/build-webapp.mjs --deps-only \
    && PATH="$(dirname "$PM_PNPM_BIN"):$(dirname "$PM_NODE_BIN"):$PATH" node apps/desktop/scripts/build-webapp.mjs \
    && test -f /opt/hermes-agent/apps/desktop/dist-webapp/index.html \
    && cd / \
    && chown -R harness:harness /opt/hermes-agent \
    # Ship only dist-webapp, like upstream's runtime image: the private webapp
    # build workspace is not kept. The runtime needs no node/pnpm - the baked
    # bundle carries its freshness receipt and `hermes webapp` proves it
    # current without rebuilding. There is no in-image update or rebuild path:
    # hermes updates ship bundled in new images (same as lazy installs, which
    # are disabled by design).
    && rm -rf /opt/hermes-agent/.git /opt/hermes-agent/web/node_modules /opt/hermes-agent/node_modules /opt/hermes-agent/.build /root/.cache/uv /root/.hermes /root/.npm /root/.local/share/pnpm \
    && rm -rf /var/lib/apt/lists/*

# Chromium shared libraries required to run Playwright browsers (the default
# browser for the @playwright/mcp server). Minimum deps for Chromium only;
# Firefox/WebKit would need additional GTK/GStreamer libs. See issue #128.
# hadolint ignore=DL3008
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libglib2.0-0t64 \
        libnspr4 \
        libnss3 \
        libatk1.0-0t64 \
        libatk-bridge2.0-0t64 \
        libdbus-1-3 \
        libcups2t64 \
        libxcb1 \
        libxkbcommon0 \
        libasound2t64 \
        libgbm1 \
        libx11-6 \
        libxext6 \
        libcairo2 \
        libpango-1.0-0 \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxrandr2 \
        libatspi2.0-0t64 \
    && rm -rf /var/lib/apt/lists/*

COPY hermes/local.yaml /etc/harness/hermes-local.yaml

# Pin the dashboard to the image-baked web dist (#204). With this set,
# `hermes dashboard` validates the dist and serves it; it never consults
# build freshness (which would require PM's node and web/node_modules —
# both deliberately excluded from the runtime image). This mirrors the
# env hermes-agent's own Docker image sets for the same reason.
ENV HERMES_WEB_DIST=/opt/hermes-agent/hermes_cli/web_dist
ENV HERMES_DISABLE_LAZY_INSTALLS=1

COPY entrypoint-hermes.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

USER harness
WORKDIR /app
ENTRYPOINT ["/tini", "--", "/entrypoint.sh"]
