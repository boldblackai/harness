ARG BASE_IMAGE=ghcr.io/boldblackai/harness:latest
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

USER root

RUN pnpm install -g opencode-ai@1.18.34 && \
    cd "$(pnpm list -g --parseable --depth 0 | grep '/opencode-ai$')" && node postinstall.mjs && \
    pnpm store prune && \
    rm -rf ~/.cache/pnpm ~/.npm

RUN mkdir -p /etc/opencode

COPY opencode/*.json /etc/opencode/

COPY entrypoint-opencode.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

USER harness
WORKDIR /app
ENTRYPOINT ["/tini", "--", "/entrypoint.sh"]
